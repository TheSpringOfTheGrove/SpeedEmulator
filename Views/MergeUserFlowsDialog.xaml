<Window x:Class="SpeedEmulator.Views.MergeUserFlowsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认合并流水"
        Width="520"
        Height="448"
        MinWidth="480"
        MinHeight="410"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CDD2D5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="确认合并流水"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#1D2A30" />

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,12"
                   TextWrapping="Wrap"
                   Foreground="#52646A"
                   FontSize="13"
                   Text="请选择接收流水的目标用户。窗口会先展示合并前后的流水数量；确认后才会执行合并。" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="已选用户"
                       FontWeight="SemiBold"
                       Foreground="#1D2A30" />
            <ListBox Margin="0,8,0,0"
                     ItemsSource="{Binding SelectedUsers}"
                     DisplayMemberPath="DisplayName"
                     Height="74"
                     IsHitTestVisible="False"
                     Background="White"
                     BorderBrush="#D8D8D8"
                     BorderThickness="1"
                     Padding="6,2" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Margin="0,12,0,0"
                   Text="{Binding MergeSummary}"
                   TextWrapping="Wrap"
                   Foreground="#176B66"
                   FontWeight="SemiBold" />

        <CheckBox Grid.Row="4"
                  Margin="0,12,0,0"
                  IsChecked="{Binding ClearSourceUsersAndFlows, UpdateSourceTrigger=PropertyChanged}"
                  Content="合并后清空非目标用户的流水和用户"
                  Foreground="#1D2A30" />

        <TextBlock Grid.Row="5"
                   Margin="22,4,0,0"
                   Text="{Binding SourceRetentionText}"
                   TextWrapping="Wrap"
                   Foreground="#8A5A00"
                   FontSize="12" />

        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="合并到"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Foreground="#1D2A30" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SelectedUsers}"
                      SelectedItem="{Binding SelectedTarget, UpdateSourceTrigger=PropertyChanged}"
                      DisplayMemberPath="DisplayName"
                      Height="32"
                      Background="White" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                <Button Content="确认合并"
                        Command="{Binding ConfirmCommand}"
                        Style="{StaticResource DialogButtonStyle}" />
                <Button Content="取消"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
