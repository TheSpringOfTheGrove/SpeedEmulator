<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>SpeedEmulator.Program</StartupObject>
    <ApplicationIcon>Assets\jisu-theme-app-icon-with-year.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\SpeedEmulatorIcon.ico" />
    <Resource Include="Assets\SpeedEmulatorIcon.png" />
    <Resource Include="Assets\jisu-theme-app-icon-with-year.ico" />
    <Resource Include="Assets\jisu-theme-app-icon-with-year.png" />
    <Resource Include="Assets\jisu-theme-home-header-banner-year-blank.png" />
    <Resource Include="Assets\jisu-theme-home-header-year-blank.png" />
    <Resource Include="Assets\jisu-theme-logo-vertical-with-year.png" />
    <Resource Include="Assets\jisu-theme-logo-vertical-year-blank.png" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="db.db" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Include="db2.db" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Include="Data\*.json" Exclude="Data\bank-users-seed.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Data\bank-users-seed.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Include="VendorRuntime\Zhencheng\**\*" Exclude="VendorRuntime\Zhencheng\.gitkeep;VendorRuntime\Zhencheng\Stimulsoft*.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="zhencheng-runtime\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Vendor QuestPDF templates resolve bank logos and seals from AppContext.BaseDirectory/static. -->
    <Content Include="VendorRuntime\Zhencheng\static\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="static\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Stirptkm">
      <HintPath>VendorRuntime\StimulsoftLicense\Stirptkm.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PdfSharpCore">
      <HintPath>VendorRuntime\Zhencheng\PdfSharpCore.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
    <PackageReference Include="QuestPDF" Version="2026.7.1" />
    <PackageReference Include="Stimulsoft.Reports.Wpf" Version="2026.3.3" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
